# Environment configuration for Assignment Autopsy application.
APP_ENV= # Set the application environment ('development', 'production', 'testing')
APP_DEBUG= # Set to 'true' to enable debug mode, 'false' otherwise.
APP_SECRET_KEY= # Set a secret key for the application.
APP_BASE_URL= # Set the base URL of the application.
APP_HOST= # Set the host for the application.
APP_PORT= # Set the port for the application.

DATABASE_URL= # Set the database connection URL. Must be a PosgreSQL database.

FEATHERLESS_API_KEY= # Set the API key for Featherless service.
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1 # Set the base URL for Featherless API, it should not be changed unless necessary
FEATHERLESS_MODEL= # Set the model to be used by the Featherless API, e.g., 'moonshotai/Kimi-K2-Instruct'
FEATHERLESS_MAX_OUTPUT_TOKENS= # Set the maximum number of output tokens for the Featherless API.
FEATHERLESS_MAX_CONCURRENT_REQUESTS= # Set the maximum number of concurrent requests to the Featherless API.

STORAGE_PROVIDER= # Set the storage provider: 'local' (disk, lost on redeploy on hosts with an ephemeral filesystem) or 'github' (private GitHub repo used as a free CDN, recommended for Render.com and similar hosts).
STORAGE_GITHUB_TOKEN= # Fine-grained PAT with Contents read/write access to the repo below. Required when STORAGE_PROVIDER=github.
STORAGE_GITHUB_REPO= # Private repo to store files in, as 'owner/name'. Required when STORAGE_PROVIDER=github.
STORAGE_GITHUB_BRANCH=main # Branch to commit files to.
MAX_UPLOAD_SIZE= # Set the maximum upload size in bytes.

SESSION_COOKIE_NAME= # Set the name of the session cookie.
SESSION_TTL= # Set the session time-to-live (TTL) in seconds.
SESSION_SECURE= # Set to 'true' to enable secure cookies, 'false' otherwise.
SESSION_SAME_SITE= # Set the SameSite attribute for the session cookie ('lax', 'strict', 'none').

# [optional] Google OAuth configuration, leave blank to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID= # Set the Google OAuth client ID.
GOOGLE_OAUTH_CLIENT_SECRET= # Set the Google OAuth client secret.
GOOGLE_OAUTH_REDIRECT_URI= # Set the Google OAuth redirect URI.
